{
  "name": "localship",
  "version": "0.4.0",
  "description": "Translate your app with the AI you already use. An MCP server, agent skills and CLI that check every translation before it's written. Android, Apple String Catalogs, gettext, Flutter ARB and JSON.",
  "keywords": [
    "localization",
    "l10n",
    "i18n",
    "translation",
    "android",
    "ios",
    "xcstrings",
    "string-catalog",
    "gettext",
    "flutter",
    "arb",
    "i18next",
    "mcp",
    "mcp-server",
    "claude-code",
    "agent-skills",
    "ai"
  ],
  "homepage": "https://github.com/jigarfumakiya/localship#readme",
  "bugs": {
    "url": "https://github.com/jigarfumakiya/localship/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jigarfumakiya/localship.git"
  },
  "license": "MIT",
  "author": "Jigar Fumakiya (https://github.com/jigarfumakiya)",
  "type": "module",
  "bin": {
    "localship": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "benchmark": "tsx benchmarks/localization.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
